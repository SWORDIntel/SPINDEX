# SPINDEX Backend Configuration
# Copy this file to .env and update with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# ============================================
# ELASTICSEARCH CONFIGURATION
# ============================================
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=30

# ============================================
# REDIS / CELERY CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_BROKER=0
REDIS_DB_BACKEND=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite (default)
DATABASE_URL=sqlite:///./spindex_aegis.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/spindex

# ============================================
# AUTHENTICATION TOKENS
# ============================================
# IMPORTANT: Change these tokens in production!
AEGIS_TOKEN_ADMIN=secure-dev-token-admin
AEGIS_TOKEN_ANALYST=secure-dev-token-analyst
AEGIS_TOKEN_VIEWER=secure-dev-token-viewer

# Token expiration (in seconds)
TOKEN_EXPIRATION=86400

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
STAGED_FILES_DIR=./staged_files
ALLOWED_EXTENSIONS=json,csv,geojson,txt,pdf,doc,docx,xls,xlsx,rtf,sqlite,db

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/spindex.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# PERFORMANCE TUNING
# ============================================
# AVX-512 acceleration
ENABLE_AVX512=true
AVX_THREAD_COUNT=4

# Query timeouts (seconds)
QUERY_TIMEOUT=30
SEARCH_MAX_RESULTS=10000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# SECURITY SETTINGS
# ============================================
# Enable security headers
ENABLE_SECURITY_HEADERS=true

# HTTPS enforcement (set to true in production)
FORCE_HTTPS=false

# Session configuration
SESSION_SECRET_KEY=change-me-in-production-to-a-random-string

# ============================================
# MONITORING & HEALTH CHECKS
# ============================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
SENTRY_DSN=

# ============================================
# PLUGIN CONFIGURATION
# ============================================
PLUGINS_DIR=./plugins
ENABLE_PLUGINS=true

# ============================================
# GEOCODING CONFIGURATION
# ============================================
GEOCODING_PROVIDER=nominatim
GEOCODING_TIMEOUT=10
GEOCODING_USER_AGENT=SPINDEX/1.0

# ============================================
# BACKUP & MAINTENANCE
# ============================================
BACKUP_DIR=./backups
AUTO_BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24

# ============================================
# DEVELOPMENT OPTIONS
# ============================================
# Auto-reload on code changes
AUTO_RELOAD=true

# Show detailed error pages
SHOW_ERROR_DETAILS=true

# Enable API documentation
ENABLE_DOCS=true

# Enable test endpoints
ENABLE_TEST_ENDPOINTS=false

# ESLint ignore patterns

# Build output
dist
dist-ssr
coverage

# Dependencies
node_modules

# Auto-generated files (if any, beyond build output)
# Example:
# auto-generated-types.ts

# Configuration files at root (if ESLint is run from root with a different config)
# For this setup, .eslintrc.cjs is at the root of `gui/`, so this might not be needed for these specific files.
# vite.config.ts
# tsconfig.json
# tsconfig.node.json
# postcss.config.js
# tailwind.config.js

# Dotfiles (except .eslintrc.js itself if not covered by ignore-path in script)
.*.js
.*.json
.*.cjs
# But allow .eslintrc.cjs
!/.eslintrc.cjs
!/.prettierrc.json
# .gitignore itself will usually handle these for the lint script if --ignore-path .gitignore is used

# Public folder (usually contains static assets not meant for linting)
public/*
!public/index.html # Or lint it if you want to enforce HTML standards

# Any other specific files or directories to ignore
# temp/
# *.log
# specific-generated-file.js
# src/generated/
# src/shims-vue.d.ts # Often auto-generated and doesn't need linting
# src/vite-env.d.ts  # Auto-generated
src/vite-env.d.ts
src/shims-vue.d.ts # If you add this standard Vue TS shim file later
vite.config.ts # Usually handled by specific ESLint configs for JS/TS files
               # but can be ignored if causing issues with Vue/TS parsing setup for root files.
               # The package.json script uses --ignore-path .gitignore, which is often sufficient.
               # This file is more for overriding/extending that.
node_modules/
dist/
dist-ssr/
*.local
*.log*
.DS_Store
# Coverage folder generated by tools like Vitest
coverage/
# Build folder defined by Conan
build/
# Folders from IDEs
.idea/
.vscode/
# Generated files by conan
generators/
# Files from previous step
*.pyc
*.pyo
.venv
venv
ENV
env
htmlcov
.coverage
.pytest_cache
nosetests.xml
coverage.xml
*.lcov
# tests/ # Test files should be linted
# docs/ # Documentation files are not linted by ESLint for JS/TS/Vue
# backend/
# gui/
# .github/
# alembic/
# alembic.ini
# Makefile.legacy
# main.py # Python backend main
# load.py
# log_processor.c
# setup_env.sh
# pending_tasks_analysis.txt
# spindex.rtf
# spindex.txt
# README.md
# ROADMAP.md
# GUI_DESIGN.md
# FP16.MD
# Enhancements.md
# AGENTS.md
# test_spindex_es.conf
# *.sh
# *.html
# *.css
# *.js
# These are too broad for an .eslintignore inside `gui/`.
# The lint script in package.json `eslint . --ext ... --ignore-path .gitignore` from `gui/`
# with a proper `.gitignore` at the project root is the main way to control scope.
# This `.eslintignore` inside `gui/` is for finer control *within* what eslint is already looking at.
# Let's keep it simple for now, focusing on build outputs and TS declaration files within src/.

# Standard outputs
/dist
/dist-ssr
/coverage

# Generated type declaration files
/src/vite-env.d.ts
/src/shims-vue.d.ts
# Add any other auto-generated files within src that shouldn't be linted

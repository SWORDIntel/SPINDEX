# SPINDEX Frontend Configuration
# Copy this file to .env and update with your values

# ============================================
# API CONFIGURATION
# ============================================
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# API timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ============================================
# AUTHENTICATION
# ============================================
# Default auth token for development (change in production)
VITE_DEFAULT_AUTH_TOKEN=

# Token storage key in localStorage
VITE_AUTH_TOKEN_KEY=auth_token

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_ADVANCED_SEARCH=true
VITE_ENABLE_AVX_ACCELERATION=true
VITE_ENABLE_MAP_VIEW=false
VITE_ENABLE_ANALYTICS=false

# ============================================
# UI CONFIGURATION
# ============================================
# Application title
VITE_APP_TITLE=SPINDEX - Spatial Indexing System

# Theme
VITE_THEME=light
VITE_PRIMARY_COLOR=#667eea

# ============================================
# PERFORMANCE
# ============================================
# Auto-refresh interval (milliseconds)
VITE_DASHBOARD_REFRESH_INTERVAL=30000

# Max results to display
VITE_MAX_SEARCH_RESULTS=100

# Pagination size
VITE_PAGINATION_SIZE=20

# ============================================
# UPLOAD CONFIGURATION
# ============================================
# Max file size (bytes)
VITE_MAX_FILE_SIZE=104857600

# Allowed file extensions (comma-separated)
VITE_ALLOWED_EXTENSIONS=.json,.csv,.geojson,.txt,.pdf,.doc,.docx,.xls,.xlsx,.rtf,.sqlite,.db

# ============================================
# DEVELOPMENT OPTIONS
# ============================================
# Development server port
VITE_PORT=8080

# Enable source maps
VITE_SOURCE_MAPS=true

# Enable hot module replacement
VITE_HMR=true

# API mocking (for development without backend)
VITE_USE_MOCK_API=false

# ============================================
# LOGGING & DEBUGGING
# ============================================
# Console log level (error, warn, info, debug)
VITE_LOG_LEVEL=info

# Enable performance monitoring
VITE_ENABLE_PERF_MONITORING=false

# ============================================
# EXTERNAL SERVICES
# ============================================
# Map provider (if map view is enabled)
VITE_MAP_PROVIDER=openstreetmap
VITE_MAPBOX_TOKEN=

# Analytics provider
VITE_ANALYTICS_ID=

# Sentry error tracking
VITE_SENTRY_DSN=
